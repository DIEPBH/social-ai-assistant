# ==========================================
# CẤU HÌNH DỰ ÁN SOCIAL AI ASSISTANT (.env)
# ==========================================

# 1. Django Application Config
PROJECT_NAME=social_ai_assistant
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=django-insecure-change-this-to-a-long-random-secret-key-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,http://localhost:8000
PUBLIC_BASE_URL=https://yourdomain.com

# 2. Database Config (PostgreSQL)
POSTGRES_DB=social_ai_db
POSTGRES_USER=social_ai_user
POSTGRES_PASSWORD=social_ai_secure_password_change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# 3. Cache & Celery Task Queue (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# 4. Timezone & Localization
TZ=Asia/Ho_Chi_Minh
LANGUAGE_CODE=vi
TIME_ZONE=Asia/Ho_Chi_Minh

# 5. AI Engine Config (Google Gemini)
AI_ENGINE=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# 6. Social Platforms Integration
# Zalo OA
ZALO_APP_ID=your_zalo_app_id
ZALO_APP_SECRET=your_zalo_app_secret
ZALO_WEBHOOK_SECRET=your_zalo_webhook_secret

# Facebook Messenger
FACEBOOK_VERIFY_TOKEN=your_facebook_verify_token

# 7. System & Banner Config
DAILY_REPORT_BANNER_URL=https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=800&auto=format&fit=crop
LOG_RETENTION_DAYS=7

# 8. Google ReCAPTCHA V3 Config
RECAPTCHA_PUBLIC_KEY=your_recaptcha_site_key
RECAPTCHA_PRIVATE_KEY=your_recaptcha_secret_key
